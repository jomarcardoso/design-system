{
  "name": "@org/ds",
  "version": "0.1.0",
  "private": true,
  "description": "Framework-independent design token foundation. Layer 1 compiles away, layer 2 is the public contract, adapters are leaves.",
  "type": "module",
  "exports": {
    ".": "./app.css",
    "./scss": "./src/ds.scss",
    "./dist": "./dist/ds.css",
    "./reset-a11y.css": "./reset-a11y.css",
    "./tailwind.css": "./tailwind.css"
  },
  "scripts": {
    "build:tokens": "sass --no-source-map --style=compressed src/ds.scss dist/ds.css",
    "build:bootstrap": "sass --no-source-map --style=compressed --quiet-deps --silence-deprecation=import --load-path=node_modules bootstrap-entry.scss dist/bootstrap.css",
    "watch:tokens": "sass --watch src/ds.scss dist/ds.css",
    "lint": "stylelint \"src/**/*.scss\" \"app.css\"",
    "build": "npm run build:tokens && npm run lint",
    "demo": "npm run build:tokens && npm run build:bootstrap"
  },
  "devDependencies": {
    "bootstrap": "5.3",
    "postcss-scss": "^4.0.9",
    "sass": "^1.83.0",
    "stylelint": "^16.0.0"
  },
  "peerDependencies": {
    "bootstrap": "^5.3.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "bootstrap": {
      "optional": true
    },
    "tailwindcss": {
      "optional": true
    }
  }
}
